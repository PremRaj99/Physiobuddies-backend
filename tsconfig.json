{
  "compilerOptions": {
    "target": "es2020",
    "module": "nodenext",
    "lib": ["es2017", "esnext.asynciterable"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "express"]
  },
  "exclude": ["node_modules", "dist", "prisma.config.ts", "eslint.config.ts"]
}
