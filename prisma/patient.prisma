enum Gender {
  male
  female
  other
}

// ----------------------------------------------------------------------
// PATIENT DOMAIN
// ----------------------------------------------------------------------

model Patient {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @unique @db.ObjectId // 1:1 Link to User
  patientId String // Public Business ID (e.g. PAT-2024-001)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id])

  details           PatientDetail[]
  locations         PatientLocation[]
  treatmentPlans    TreatmentPlan[]    @relation("PatientTreatmentPlans")
  reviewsGiven      TherapistReview[]  @relation("PatientGivenReviews")
  couponUsages      CouponUsage[]
  couponAssignments CouponAssignment[]
  reservations      SlotReservation[]
  patientReviews    PatientReview[]

  @@unique([userId, deletedAt])
  @@index([patientId])
}

model PatientDetail {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  patientId String @db.ObjectId

  name     String
  dob      DateTime
  gender   Gender
  phone    String
  heightCm Float?
  weightKg Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  patient Patient @relation(fields: [patientId], references: [id])
}

model PatientReview {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  therapistId     String @db.ObjectId
  treatmentPlanId String @db.ObjectId

  comment String
  rating  Float

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  patient   Patient   @relation(fields: [patientId], references: [id])
  patientId String    @db.ObjectId

  @@index([therapistId])
  @@index([patientId])
}

model PatientLocation {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  patientId String @db.ObjectId

  address    String
  landmark   String?
  city       String
  state      String
  country    String
  postalCode String
  location   Json // { lat: number, lng: number }

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Polymorphic-style relations
  patient Patient @relation(fields: [patientId], references: [id])
}
